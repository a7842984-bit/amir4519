#صف خرید ایفون 18(Queue) - . اولین نفر اولین خرید 
#
==================================================================================
===
print("=== صف خرید آیفون 18===")
queue = []
queue.append("علی") #علی اول صف 
queue.append("ریری") #ریری دوم
queue.append("رضا") #رضا سوم
queue.append("امیر") #امیر چهارم
print("صف الان:".queue) 
#حالا فروشگاه شروع میکنه به باز شدن
#هربار نفر اول صف میخره و میره
print("\nاقای".queue.pop(0)."خرید ایفون 18") #علی 
print("خانم".queue.pop(0)."خرید ایفون 18") #مریم
print("صف الان:".queue) #رضا و سارا در صف ماندن
